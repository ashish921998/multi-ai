{
  "name": "multi-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Multiplayer AI Planning Room — V1 room backend, browser app, and local Pi connector.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter='./packages/*' --filter='./apps/*' typecheck",
    "lint": "pnpm -r --filter='./packages/*' --filter='./apps/*' lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["packages/*", "apps/*"]
}
